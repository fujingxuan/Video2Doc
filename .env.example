# Backend
VIDEO2DOC_DATABASE_URL=sqlite:///./data/video2doc.db
VIDEO2DOC_DATA_DIR=./data/tasks
VIDEO2DOC_INBOX_DIR=./data/inbox
VIDEO2DOC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VIDEO2DOC_LOG_LEVEL=INFO
VIDEO2DOC_SIMULATION_STEP_SECONDS=0.20
VIDEO2DOC_PROCESS_POLL_SECONDS=0.20
VIDEO2DOC_MEDIA_TIMEOUT_SECONDS=3600
VIDEO2DOC_ASR_TIMEOUT_SECONDS=300
VIDEO2DOC_ASR_MAX_RETRIES=2
VIDEO2DOC_AUDIO_CHUNK_SECONDS=60
VIDEO2DOC_ASR_OVERLAP_SECONDS=5

# OneAPI is reserved for text-processing models. Never commit a real key.
ONEAPI_BASE_URL=
ONEAPI_API_KEY=

# Independent cloud ASR Gateway. Store only these environment-variable names
# in Video2Doc configuration; never store their values in the database.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=

# Local model runtime paths live outside this Git repository.
VIDEO2DOC_MODEL_ROOT=D:\Models\Video2Doc
VIDEO2DOC_MODEL_LOG_DIR=D:\Models\Video2Doc\logs

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
